{
  "schema": "swift-json-cli-cases/1",
  "status": "not_run",
  "executable": "swift-json",
  "default_query_options": [
    "--compact"
  ],
  "comparison_policy": "Parse expected JSON texts with native exact parser; compare stdout bytes only where stated. Preserve order/cardinality/scalar identity. Never float-coerce expected values.",
  "cases": [
    {
      "id": "format-preserved-lexemes",
      "gate": "C1",
      "requirement_ids": [
        "CL011"
      ],
      "command": "format",
      "options": [
        "--compact"
      ],
      "operands": [],
      "stdin_utf8": "[1.2300e+2,9007199254740993,-0]\n",
      "expected_exit": 0,
      "comparison": "stdout-byte-exact",
      "status": "not_run",
      "expected_stdout_utf8": "[1.2300e+2,9007199254740993,-0]\n"
    },
    {
